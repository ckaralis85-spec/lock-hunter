# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ---- Virtual environments (the build script may create these) ----
.venv/
.venv_build/
venv/
env/

# ---- PyInstaller build output ----
build/
dist/
*.spec

# ---- Packaged releases (distribute these via GitHub Releases, not the repo) ----
*.zip
LockHunter V*.zip
LockHunter-v*.zip

# ---- App runtime data / user files (must never be committed) ----
*.db
*.log
config.json
.lockhunter/
bazaar_seen.json
owners_cache.json

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
